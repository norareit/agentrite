  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ritenoar/agentrite.git"
  },
  "type": "module",
  "files": [
    "process.md",
    "CHANGELOG.md",
    "SANDBOX.md",
    "roles",
    "templates",
    "scripts/check-changes.mjs",
    "scripts/agentrite-roles.mjs",
    "scripts/agentrite-run.mjs",
    "scripts/agentrite.mjs",
