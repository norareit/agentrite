---
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, Segoe UI, Helvetica, Arial, sans-serif"
    fontSize: 15px
    lineColor: "#94a3b8"
    clusterBkg: "#f8fafc"
    clusterBorder: "#f8fafc"
    edgeLabelBackground: "#f8fafc"
    titleColor: "#0f172a"
  themeCSS: >
    .node rect, .node path { rx: 12px; ry: 12px; filter: drop-shadow(0 2px 4px rgba(15,23,42,0.12)); }
    .cluster rect { rx: 18px; ry: 18px; }
    .flowchart-link { stroke-width: 2px; }
    .edgeLabel { color: #475569; font-size: 13px; }
  flowchart:
    curve: basis
    nodeSpacing: 34
    rankSpacing: 50
    padding: 18
    wrappingWidth: 320
---
flowchart LR
  subgraph starting["<b>STARTING THE WORK&nbsp;</b>"]
    direction TB
    sandbox["<b>./sandbox.sh</b>"]
    orchestrate["<b>agentrite orchestrate</b><br/>a unit through its roles"]
    run["<b>agentrite run</b><br/>one role on one unit"]
    sandbox --> orchestrate --> run
  end
  harness(["<b>Harness</b><br/>Claude Code · OpenCode · Codex"])
  subgraph instructions["<b>WHAT THE AGENT FOLLOWS&nbsp;</b>"]
    direction TB
    wrappers["<b>Role wrappers</b><br/>.claude/agents · .opencode/agents · .codex/agents"]
    roles["<b>Roles</b><br/>specifier · planner · implementer · reviewer<br/>and roles the project adds"]
    rules["<b>process.md</b> and <b>the standards</b><br/>the kit's standards or the project's own"]
    wrappers --> roles --> rules
  end
  units@{ shape: docs, label: "<b>changes/</b><br/>spec · plan · record" }

  run -->|starts| harness
  harness -->|reads| wrappers
  harness -->|reads and writes| units

  classDef start fill:#ffffff,stroke:#6366f1,stroke-width:3px,color:#0f172a
  classDef agent fill:#ffffff,stroke:#f59e0b,stroke-width:3px,color:#0f172a
  classDef text fill:#ffffff,stroke:#94a3b8,stroke-width:1.5px,color:#0f172a
  class sandbox,orchestrate,run start
  class harness agent
  class wrappers,roles,rules,units text
