---
config:
  theme: base
  themeVariables:
    fontFamily: Arial, Helvetica, sans-serif
    fontSize: 15px
    lineColor: "#94a3b8"
    clusterBkg: "#ffffff"
    clusterBorder: "#e2e8f0"
    edgeLabelBackground: "#ffffff"
    titleColor: "#475569"
  flowchart:
    curve: basis
    nodeSpacing: 36
    rankSpacing: 56
    padding: 14
    wrappingWidth: 320
---
flowchart LR
  subgraph starting["Starting the work"]
    direction TB
    sandbox["<b>./sandbox.sh</b>"]
    orchestrate["<b>agentrite orchestrate</b><br/>a unit through its roles"]
    run["<b>agentrite run</b><br/>one role on one unit"]
    sandbox --> orchestrate --> run
  end
  harness(["<b>Harness</b><br/>Claude Code · OpenCode"])
  subgraph instructions["What the agent follows"]
    direction TB
    wrappers["<b>Role wrappers</b><br/>.claude/agents · .opencode/agents"]
    roles["<b>Roles</b><br/>specifier · planner · implementer · reviewer<br/>and roles the project adds"]
    rules["<b>process.md</b> and <b>the standards</b><br/>the kit's standards or the project's own"]
    wrappers --> roles --> rules
  end
  units@{ shape: docs, label: "<b>changes/</b><br/>spec · plan · record" }

  run -->|starts| harness
  harness -->|reads| wrappers
  harness -->|reads and writes| units

  classDef start fill:#eff6ff,stroke:#60a5fa,color:#1e3a8a
  classDef agent fill:#fef3c7,stroke:#f59e0b,color:#78350f
  classDef text fill:#f8fafc,stroke:#94a3b8,color:#0f172a
  class sandbox,orchestrate,run start
  class harness agent
  class wrappers,roles,rules,units text
